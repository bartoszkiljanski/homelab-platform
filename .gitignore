# Terraform working data and state
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.*
*.plan
tfplan
plan.out
.terraform.tfstate.lock.info
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Variable and backend files can contain credentials.
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json
!*.tfvars.example
!*.tfvars.json.example
backend.hcl
backend.*.hcl
!backend.hcl.example
credentials.tfrc.json

# Terraform dependency lockfiles are intentionally committed.
!**/.terraform.lock.hcl

